# Modelo de variáveis de ambiente do SGS Trilhas do Sul.
# Copie para .env e preencha no servidor. Nunca versione o arquivo .env.

# Banco de dados PostgreSQL
DATABASE_URL=postgres://sgs_app:TROQUE_A_SENHA@localhost:5432/sgs

# Pasta privada onde ficam os arquivos originais de cada versão (fora da pasta pública do site)
ARQUIVOS_DIR=/srv/sgs/arquivos

# Sessão e autenticação
SESSION_SECRET=TROQUE_POR_UM_VALOR_ALEATORIO_LONGO

# IA no servidor (só após aprovação de custos pelo responsável pelo SGS)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Ambiente: teste | producao
SGS_AMBIENTE=teste
